---
import Section from "../Section.astro";
import { professionalProjects } from "@cv";

const companies = [
  ...new Set(professionalProjects.map(({ company }) => company)),
];
---

<Section className={Astro.props.className} title="Professional Projects">
  <p class="text-sm text-skin-muted">
    Projects delivered at Helixiora and Vaultoro, spanning data platforms,
    analytics, AI applications, and mobile products.
  </p>
  {
    companies.map((company) => (
      <div class="flex flex-col gap-4">
        <h4 class="border-b border-skin-hue/20 pb-2 text-xl text-skin-hue">
          {company}
        </h4>
        <ul
          class="grid grid-cols-1 gap-4 md:grid-cols-2"
          aria-label={`${company} professional projects`}
        >
          {professionalProjects
            .filter((project) => project.company === company)
            .map(
              ({
                name,
                role,
                description,
                highlights,
                outcome,
                technologies,
              }) => (
                <li class="h-full">
                  <article class="flex h-full flex-col gap-3 rounded-md bg-skin-button-muted/50 p-5 shadow-sm ring-1 ring-skin-muted">
                    <header class="flex flex-col gap-2">
                      <p class="text-xs font-semibold text-skin-hue">{role}</p>
                      <h5 class="text-lg leading-snug">{name}</h5>
                    </header>
                    <p class="text-sm text-skin-muted">{description}</p>
                    <p class="text-sm">
                      <span class="font-semibold">Outcome: </span>
                      <span class="text-skin-muted">{outcome}</span>
                    </p>
                    <details class="text-sm">
                      <summary class="cursor-pointer rounded-sm font-medium text-skin-hue hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-skin-hue">
                        My contribution
                      </summary>
                      <ul class="ml-4 mt-3 list-disc space-y-2 text-skin-muted">
                        {highlights.map((highlight) => (
                          <li>{highlight}</li>
                        ))}
                      </ul>
                    </details>
                    <ul
                      class="mt-auto flex flex-wrap gap-2 pt-2"
                      aria-label="Technologies used"
                    >
                      {technologies.map((technology) => (
                        <li class="rounded-md border border-skin-hue/20 bg-skin-button-accent/20 px-2 py-0.5 text-xs text-skin-hue">
                          {technology}
                        </li>
                      ))}
                    </ul>
                  </article>
                </li>
              ),
            )}
        </ul>
      </div>
    ))
  }
</Section>
